# Local journey planning is the default. It collects no card details or money.
PAYMENT_MODE=simulation

# Retained for later operator-approved test integration. Do not enable on the public site
# until a real operator, payment terms, and privacy/contact details are in place.
FLW_SECRET_KEY=FLWSECK_TEST-replace_me
APP_BASE_URL=http://localhost:3000

# Local-only sample customer records for design review. Leave false for public deployments.
NEXT_PUBLIC_SHOW_SAMPLE_JOURNEYS=false

# Auth.js with Google OAuth. Create a Web application OAuth client in Google Cloud.
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
AUTH_SECRET=replace_me_with_a_random_secret_of_at_least_32_characters
AUTH_GOOGLE_ID=replace_me
AUTH_GOOGLE_SECRET=replace_me
