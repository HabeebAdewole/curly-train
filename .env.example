# Local payment simulation is the default. It collects no card details or money.
PAYMENT_MODE=simulation

# Later: set PAYMENT_MODE=flutterwave and add your sandbox secret key.
# Never use a live-mode key for this portfolio demo.
FLW_SECRET_KEY=FLWSECK_TEST-replace_me
APP_BASE_URL=http://localhost:3000

# Auth.js with Google OAuth. Create a Web application OAuth client in Google Cloud.
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
AUTH_SECRET=replace_me_with_a_random_secret_of_at_least_32_characters
AUTH_GOOGLE_ID=replace_me
AUTH_GOOGLE_SECRET=replace_me
